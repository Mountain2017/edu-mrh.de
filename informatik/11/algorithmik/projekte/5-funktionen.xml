Rechtsklick auf einen eigenen Block → 'bearbeiten…' zeigt die Definition.</notes><thumbnail></thumbnail><stage name="Bühne" width="480" height="360" costume="0" tempo="60" threadsafe="false" penlog="false" volume="100" pan="0" lines="round" ternary="false" hyperops="true" codify="false" inheritance="true" sublistIDs="false" scheduled="false" id="1"><pentrails></pentrails><costumes><list id="2"></list></costumes><sounds><list id="3"></list></sounds><variables></variables><blocks></blocks><scripts></scripts><sprites select="1"><sprite name="Figur" idx="1" x="0" y="0" heading="90" scale="1" volume="100" pan="0" rotation="1" draggable="true" costume="0" color="80,80,80,1" pen="tip" id="8"><costumes><list id="9"></list></costumes><sounds><list id="10"></list></sounds><blocks></blocks><variables></variables><scripts><comment x="20" y="20" w="280" collapsed="false">Skript A (Flagge): Der Block 'Quadrat mit Seite' wird dreimal aufgerufen – mit verschiedenen Werten. Was entsteht?</comment><script x="20" y="97"><block s="receiveGo"></block><block s="clear"></block><block s="gotoXY"><l>-80</l><l>-80</l></block><block s="setHeading"><l>90</l></block><block s="setSize"><l>3</l></block><block s="setColor"><color>30,90,200,1</color></block><block s="down"></block><custom-block s="Quadrat mit Seite %n"><l>50</l></custom-block><custom-block s="Quadrat mit Seite %n"><l>100</l></custom-block><custom-block s="Quadrat mit Seite %n"><l>150</l></custom-block><block s="up"></block></script><comment x="20" y="392" w="280" collapsed="false">Skript B (Taste v): Zwei Parameter.</comment><script x="20" y="439"><block s="receiveKey"><l>v</l></block><block s="clear"></block><block s="gotoXY"><l>-80</l><l>-80</l></block><block s="setHeading"><l>90</l></block><block s="setSize"><l>3</l></block><block s="setColor"><color>200,60,60,1</color></block><block s="down"></block><custom-block s="Vieleck mit %n Ecken und Seite %n"><l>6</l><l>70</l></custom-block><block s="up"></block></script><comment x="340" y="20" w="280" collapsed="false">Skript C (Taste m): Ein Block, der etwas ZURÜCKGIBT. Welche Zahl?</comment><script x="340" y="82"><block s="receiveKey"><l>m</l></block><block s="doSayFor"><custom-block s="Mittelwert von %n und %n"><l>4</l><l>10</l></custom-block><l>2</l></block><block s="doSayFor"><custom-block s="Mittelwert von %n und %n"><l>7</l><l>8</l></custom-block><l>2</l></block></script><comment x="340" y="239" w="280" collapsed="false">Skript D (Taste g): Ein Block, der WAHR oder FALSCH zurückgibt.</comment><script x="340" y="301"><block s="receiveKey"><l>g</l></block><block s="doAsk"><l>Nenne eine Zahl:</l></block><block s="doIfElse"><custom-block s="ist %n gerade?"><block s="getLastAnswer"></block></custom-block><script><block s="doSayFor"><l>gerade</l><l>2</l></block></script><script><block s="doSayFor"><l>ungerade</l><l>2</l></block></script></block></script></scripts></sprite></sprites></stage><hidden></hidden><headers></headers><code></code><blocks><block-definition s="Quadrat mit Seite %'seite'" type="command" category="pen"><inputs><input type="%n"></input></inputs><script><block s="doRepeat"><l>4</l><script><block s="forward"><block var="seite"/></block><block s="turn"><l>90</l></block></script></block></script></block-definition><block-definition s="Vieleck mit %'ecken' Ecken und Seite %'seite'" type="command" category="pen"><inputs><input type="%n"></input><input type="%n"></input></inputs><script><block s="doRepeat"><block var="ecken"/><script><block s="forward"><block var="seite"/></block><block s="turn"><block s="reportQuotient"><l>360</l><block var="ecken"/></block></block></script></block></script></block-definition><block-definition s="Mittelwert von %'a' und %'b'" type="reporter" category="operators"><inputs><input type="%n"></input><input type="%n"></input></inputs><script><block s="doReport"><block s="reportQuotient"><block s="reportVariadicSum"><list><block var="a"/><block var="b"/></list></block><l>2</l></block></block></script></block-definition><block-definition s="ist %'zahl' gerade?" type="predicate" category="operators"><inputs><input type="%n"></input></inputs><script><block s="doReport"><block s="reportVariadicEquals"><list><block s="reportModulus"><block var="zahl"/><l>2</l></block><l>0</l></list></block></block></script></block-definition></blocks><variables></variables></project>