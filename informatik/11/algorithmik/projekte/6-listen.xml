/l></block><block s="doSayFor"><l>① entferne 1</l><l>2</l></block><block s="doDeleteFromList"><l>1</l><block var="einkauf"/></block><block s="doSayFor"><l>② füge Eier als 1 ein</l><l>2</l></block><block s="doInsertInList"><l>Eier</l><l>1</l><block var="einkauf"/></block><block s="doSayFor"><l>③ ersetze Element 3 durch Birnen</l><l>2</l></block><block s="doReplaceInList"><l>3</l><block var="einkauf"/><l>Birnen</l></block><block s="doSayFor"><l>④ füge Tee hinzu</l><l>2</l></block><block s="doAddToList"><l>Tee</l><block var="einkauf"/></block><block s="doSayFor"><block s="reportJoinWords"><list><l>An Stelle 3 steht jetzt: </l><block s="reportListItem"><l>3</l><block var="einkauf"/></block></list></block><l>3</l></block></script><comment x="490" y="20" w="280" collapsed="false">Skript C (Taste s): Notenpunkte einer Klausur. Welche zwei Zahlen sagt die Figur?</comment><script x="490" y="104"><block s="receiveKey"><l>s</l></block><block s="doSetVar"><l>punkte</l><block s="reportNewList"><list><l>12</l><l>7</l><l>15</l><l>9</l><l>11</l></list></block></block><block s="doSetVar"><l>summe</l><l>0</l></block><block s="doForEach"><l>Element</l><block var="punkte"/><script><block s="doChangeVar"><l>summe</l><block var="Element"/></block></script></block><block s="doSayFor"><block s="reportJoinWords"><list><l>Summe: </l><block var="summe"/></list></block><l>2</l></block><block s="doSayFor"><block s="reportJoinWords"><list><l>Durchschnitt: </l><block s="reportQuotient"><block var="summe"/><block s="reportListAttribute"><l><option>length</option></l><block var="punkte"/></block></block></list></block><l>3</l></block></script><comment x="490" y="343" w="280" collapsed="false">Skript D (Taste z): Wer wischt die Tafel? Kann die Figur einen Namen sagen, der nicht in der Liste steht?</comment><script x="490" y="442"><block s="receiveKey"><l>z</l></block><block s="doSetVar"><l>klasse</l><block s="reportNewList"><list><l>Anna</l><l>Ben</l><l>Cem</l><l>Dana</l><l>Emil</l></list></block></block><block s="doSetVar"><l>nr</l><block s="reportRandom"><l>1</l><block s="reportListAttribute"><l><option>length</option></l><block var="klasse"/></block></block></block><block s="doSayFor"><block s="reportJoinWords"><list><block s="reportListItem"><block var="nr"/><block var="klasse"/></block><l> wischt heute die Tafel.</l></list></block><l>3</l></block></script><comment x="490" y="598" w="280" collapsed="false">Skript E (Taste e): Die Liste wächst mit jeder Eingabe.</comment><script x="490" y="682"><block s="receiveKey"><l>e</l></block><block s="doSetVar"><l>namen</l><block s="reportNewList"><list></list></block></block><block s="doAsk"><l>Wer ist in deinem Team? (fertig = Ende)</l></block><block s="doUntil"><block s="reportVariadicEquals"><list><block s="getLastAnswer"></block><l>fertig</l></list></block><script><block s="doAddToList"><block s="getLastAnswer"></block><block var="namen"/></block><block s="doAsk"><l>Noch jemand? (fertig = Ende)</l></block></script></block><block s="doSayFor"><block s="reportJoinWords"><list><l>Dein Team hat </l><block s="reportListAttribute"><l><option>length</option></l><block var="namen"/></block><l> Mitglieder.</l></list></block><l>3</l></block></script></scripts></sprite><watcher var="einkauf" style="normal" x="10" y="10" color="243,118,29"/><watcher var="namen" style="normal" x="370" y="10" color="243,118,29"/><watcher var="punkte" style="normal" x="10" y="190" color="243,118,29"/><watcher var="summe" style="normal" x="370" y="320" color="243,118,29"/></sprites></stage><hidden></hidden><headers></headers><code></code><blocks></blocks><variables><variable name="einkauf"><l></l></variable><variable name="punkte"><l></l></variable><variable name="summe"><l>0</l></variable><variable name="klasse"><l></l></variable><variable name="nr"><l>0</l></variable><variable name="namen"><l></l></variable></variables></project>